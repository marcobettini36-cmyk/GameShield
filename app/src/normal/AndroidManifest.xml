<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SEND_SMS" tools:node="${normalSmsNode}" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <application android:theme="@style/NormalTheme" android:icon="@mipmap/normal_launcher" android:roundIcon="@mipmap/normal_launcher" tools:replace="android:theme,android:icon">
        <activity android:name="it.gameshield.MainActivity" android:exported="false" tools:node="replace" />
        <activity android:name="it.gameshield.NormalHomeActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name="it.gameshield.NormalSetupActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalHelpActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalLayersActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalDnsActivity" android:exported="false" />
        <service android:name="it.gameshield.NormalContentService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true" android:label="GameShield: blocco contenuti gambling">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/normal_accessibility" />
        </service>
        <receiver android:name="it.gameshield.AdminReceiver" tools:node="remove" />
        <activity android:name="it.gameshield.NormalDisableActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalSettingsActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalResilienceActivity" android:exported="false" />
        <activity android:name="it.gameshield.NormalEmergencyActivity" android:exported="false" />
        <receiver android:name="it.gameshield.NormalAdminReceiver" android:permission="android.permission.BIND_DEVICE_ADMIN" android:exported="true">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/normal_admin" />
            <intent-filter><action android:name="android.app.action.DEVICE_ADMIN_ENABLED" /></intent-filter>
        </receiver>
        <provider android:name="it.gameshield.NormalInitializer" android:authorities="${applicationId}.normal.init" android:exported="false" />
        <service android:name="it.gameshield.NormalMonitorService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-consented VPN status supervision, bounded recovery and opted-in outage alert timer" />
        </service>
        <service android:name="it.gameshield.NormalCheckJob" android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name="it.gameshield.NormalBootReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name="it.gameshield.NormalSmsSentReceiver" android:exported="false" tools:node="${normalSmsNode}" />
        <service android:name="it.gameshield.ShieldVpnService" android:foregroundServiceType="specialUse">
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="true" />
        </service>
    </application>
</manifest>
